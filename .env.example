# FORGE & FUEL Environment Variables Example
# External APIs are built behind clean service interfaces with offline/mock fallbacks.
# If an API key is omitted, the app will smoothly use simulated data.

# ─── Free Food Database APIs (Optional) ────────────────────────
# Open Food Facts (Free public API, no key required by default)
VITE_OPEN_FOOD_FACTS_API_URL=https://world.openfoodfacts.org/cgi/search.pl

# USDA FoodData Central API (Optional - sign up at https://fdc.nal.usda.gov/api-key-signup.html)
VITE_USDA_API_KEY=your_usda_api_key_here

# ─── Email Delivery Service (Phase 2 - Optional) ────────────────
# Resend or SMTP provider credentials for weekly progress emails
VITE_EMAIL_PROVIDER=mock
VITE_RESEND_API_KEY=re_your_resend_api_key_here
VITE_EMAIL_FROM=coach@forgefuel.app

# ─── AI Coaching & NLP Parser (Phase 4 - Optional) ──────────────
# OpenAI or Gemini API key for smart training recommendations
VITE_AI_PROVIDER=mock
VITE_OPENAI_API_KEY=sk-your_openai_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Spotify Integration (Phase 5 - Optional) ───────────────────
# Spotify Web API client ID for workout playlist matching
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# ─── Wearables & Health Sync (Phase 5 - Optional) ───────────────
VITE_GOOGLE_FIT_CLIENT_ID=your_google_fit_client_id_here
VITE_FITBIT_CLIENT_ID=your_fitbit_client_id_here
